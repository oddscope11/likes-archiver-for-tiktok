{
  "manifest_version": 3,
  "name": "Likes Archiver for TikTok",
  "version": "0.1.1",
  "description": "Archives your liked TikTok videos to a local folder.",
  "action": {
    "default_title": "Likes Archiver for TikTok"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://*.tiktokcdn.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
